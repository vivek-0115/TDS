TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://aipipe.org/openai/v1
OPENAI_MODEL=gpt-4o
# Public run log hosting (one of the two):
# 1) GitHub raw URL (recommended): set both GITHUB_REPO and GITHUB_TOKEN.
#    run.jsonl is pushed to <GITHUB_REPO>/run.jsonl, public at
#    https://raw.githubusercontent.com/<GITHUB_REPO>/main/run.jsonl
GITHUB_REPO=your_username/your_repo
GITHUB_TOKEN=ghp_your_fine_grained_pat_with_contents_read_write
# 2) Or a public GCS bucket base URL:
LOG_URL_BASE=
# Optional secret used to verify Telegram webhook calls:
WEBHOOK_SECRET=your_random_secret
